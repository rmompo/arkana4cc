#!/usr/bin/env python3
"""Asistente de credenciales de git (`git credential helper`) de Arkana.

git lo invoca con `get|store|erase` y le pasa por stdin `protocol=…`, `host=…`, `path=…`. Para `get` busca el componente cuyo
`remote_host` coincide con el host y devuelve `username` y `password` (el token de la clave `git.token_ref` del manifiesto, que sale
de `.arkana/.credentials`). `store` y `erase` no hacen nada: las credenciales no se guardan en ningún otro sitio. Si no hay
coincidencia no imprime nada y git sigue con los demás asistentes. No escribe nada en stderr con valores.
"""
import os
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, os.path.join(HERE, "_core"))
sys.path.insert(0, os.path.join(HERE, "lib"))


def main():
    op = sys.argv[1] if len(sys.argv) > 1 else ""
    if op != "get":
        return 0
    req = {}
    for linea in sys.stdin:
        if "=" in linea:
            k, v = linea.rstrip("\n").split("=", 1)
            req[k] = v
    if req.get("protocol") not in ("https", "http") or not req.get("host"):
        return 0
    try:
        from arkana_core import manifest
        import credentials
        ws = manifest.load(cwd=os.environ.get("GIT_DIR") and os.path.dirname(os.environ["GIT_DIR"]) or os.getcwd())
        host = req["host"].lower()
        for a in ws.aliases():
            b = ws.get(a)
            if (b.get("remote_host") or "").lower() != host:
                continue
            git = b.get("git") or {}
            token = git.get("token_ref") and credentials.get(ws.home, git["token_ref"])
            if token:
                sys.stdout.write(f"username={git.get('username') or 'oauth2'}\npassword={token}\n")
                return 0
    except Exception:
        return 0
    return 0


if __name__ == "__main__":
    sys.exit(main())
