{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [{"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/lib/ledger.py\" hook session-start", "timeout": 5}]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [{"type": "command", "command": "python3 -I \"${CLAUDE_PLUGIN_ROOT}/scripts/lib/ledger.py\" hook session-end", "timeout": 5}]
      }
    ]
  }
}
